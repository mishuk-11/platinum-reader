{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Platinum Reader",
  "version": "0.3.0-beta",
  "identifier": "io.github.mishuk11.platinumreader",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "Platinum Reader",
        "width": 1200,
        "height": 820,
        "minWidth": 520,
        "minHeight": 380,
        "decorations": false,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self' ipc: http://ipc.localhost; img-src 'self' blob: data:; style-src 'self' 'unsafe-inline'; script-src 'self' 'wasm-unsafe-eval' blob:; worker-src 'self' blob:; connect-src 'self' ipc: http://ipc.localhost ws://localhost:1420 https://api.github.com"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "deb", "rpm", "appimage", "dmg", "app"],
    "category": "Productivity",
    "shortDescription": "Ultra-lightweight document reader",
    "longDescription": "Platinum Reader is a fast, open-source reader for PDF, EPUB, MOBI, CBZ/CBR, DjVu, XPS, Markdown and CHM.",
    "copyright": "© 2026 Inzamam Islam — AGPL-3.0",
    "license": "AGPL-3.0-or-later",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": { "installMode": "both", "installerHooks": "windows/hooks.nsh" }
    },
    "linux": {
      "deb": { "depends": ["p7zip-full"] }
    },
    "fileAssociations": [
      { "ext": ["pdf"], "name": "PlatinumReader.pdf", "description": "PDF Document", "mimeType": "application/pdf", "role": "Viewer" },
      { "ext": ["epub"], "name": "PlatinumReader.epub", "description": "EPUB Book", "mimeType": "application/epub+zip", "role": "Viewer" },
      { "ext": ["mobi", "azw", "azw3"], "name": "PlatinumReader.mobi", "description": "Kindle Book", "mimeType": "application/x-mobipocket-ebook", "role": "Viewer" },
      { "ext": ["fb2"], "name": "PlatinumReader.fb2", "description": "FictionBook", "mimeType": "application/x-fictionbook+xml", "role": "Viewer" },
      { "ext": ["cbz"], "name": "PlatinumReader.cbz", "description": "Comic Book (ZIP)", "mimeType": "application/vnd.comicbook+zip", "role": "Viewer" },
      { "ext": ["cbr"], "name": "PlatinumReader.cbr", "description": "Comic Book (RAR)", "mimeType": "application/vnd.comicbook-rar", "role": "Viewer" },
      { "ext": ["djvu", "djv"], "name": "PlatinumReader.djvu", "description": "DjVu Document", "mimeType": "image/vnd.djvu", "role": "Viewer" },
      { "ext": ["xps", "oxps"], "name": "PlatinumReader.xps", "description": "XPS Document", "mimeType": "application/oxps", "role": "Viewer" },
      { "ext": ["md", "markdown"], "name": "PlatinumReader.md", "description": "Markdown Document", "mimeType": "text/markdown", "role": "Viewer" },
      { "ext": ["chm"], "name": "PlatinumReader.chm", "description": "Compiled HTML Help", "mimeType": "application/vnd.ms-htmlhelp", "role": "Viewer" }
    ]
  }
}
